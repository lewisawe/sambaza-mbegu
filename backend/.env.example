NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
DATABASE_URL=postgresql+psycopg://mbegu:mbegu_pass@localhost:5432/mbegu
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production

# --- LLM provider abstraction (app/services/llm_provider.py) ---
# LLM_PROVIDER: featherless | openai | local | bedrock | anthropic | none
#   Default when unset: 'featherless' if FEATHERLESS_API_KEY is present, else 'none'.
#   'none' (or no key) = safe no-op; non-AI features work with NO key.
LLM_PROVIDER=none
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# Generic key; falls back to FEATHERLESS_API_KEY / OPENAI_API_KEY for back-compat.
LLM_API_KEY=
# Base URL for LLM_PROVIDER=local (OpenAI-compatible, e.g. http://localhost:11434)
LLM_BASE_URL=
# Used only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

FEATHERLESS_API_KEY=your-key-here
AT_API_KEY=your-africastalking-key
AT_USERNAME=sandbox
META_VERIFY_TOKEN=mbegu_verify
META_WHATSAPP_TOKEN=your-meta-token
META_PHONE_NUMBER_ID=your-phone-id
OPENAI_API_KEY=your-openai-key-for-whisper
