# Kimur production environment — EXAMPLE / TEMPLATE.
#
# Copy to .env.prod and fill in real values. .env.prod is gitignored and must
# NEVER be committed. Generate secrets on the host (see deploy/DEPLOY.md):
#   JWT_SECRET      : openssl rand -hex 32
#   DB passwords    : openssl rand -base64 24
#
# Rules:
#  - NO dev defaults here (no mbegu/mbegu_pass, neo4j/password, change-me...).
#  - Keep the three "wiring" blocks consistent (see comments below).
#  - The stack boots and serves ALL non-AI features with the LLM/channel keys
#    left blank — only fill them if/when you enable those integrations.

# ---- Auth ----
# openssl rand -hex 32
JWT_SECRET=

# ---- Neo4j ----
# Set NEO4J_PASSWORD, then make NEO4J_AUTH exactly "neo4j/<that same password>".
NEO4J_PASSWORD=
NEO4J_AUTH=neo4j/
# Connection vars the backend reads (service-name DNS on the compose network).
# NEO4J_USER must stay "neo4j" to match NEO4J_AUTH above.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# ---- Postgres ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=kimur
# DATABASE_URL user/password/db MUST match the three POSTGRES_* values above.
# Host is the compose service name "postgres" (never localhost).
DATABASE_URL=postgresql+psycopg://<user>:<password>@postgres:5432/kimur

# ---- Redis ----
# Service-name DNS on the compose network (never localhost).
REDIS_URL=redis://redis:6379/0

# ---- CORS (optional hardening) ----
# Comma-separated allowed origins. "*" preserves current behavior. For a locked
# down prod set e.g. CORS_ALLOW_ORIGINS=https://kimur.app
CORS_ALLOW_ORIGINS=*

# ---- LLM provider (optional; app no-ops when unset) ----
# LLM_PROVIDER: featherless | openai | local | bedrock | anthropic | none
# Leave as "none" for launch — AI features gracefully no-op with NO key.
LLM_PROVIDER=none
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_API_KEY=
LLM_BASE_URL=
FEATHERLESS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Messaging channels (optional; blank = disabled) ----
AT_API_KEY=
AT_USERNAME=
META_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
